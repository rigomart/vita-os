{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["@cloudflare/vitest-plugin/types"]
  },
  "include": [
    "src",
    "test",
    "environment-augmentation.d.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
