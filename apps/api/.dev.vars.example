# Copy to apps/api/.dev.vars for `bunx wrangler dev`. These are the Worker's
# own secrets and never reach the browser.

# Signs Better Auth's sessions. Any 32+ character string works locally.
BETTER_AUTH_SECRET=local-development-secret-at-least-32-chars

# Where Better Auth believes it is served from: the address wrangler prints.
BETTER_AUTH_URL=http://localhost:8787

# The only origin allowed to make credentialed requests — the Vite dev server.
BROWSER_ORIGIN=http://localhost:5173
