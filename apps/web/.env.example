# Copy to .env.local. `bunx convex dev` fills in CONVEX_DEPLOYMENT and
# VITE_CONVEX_URL; set VITE_CONVEX_SITE_URL by hand (same host, `.site` TLD).

# Deployment the Convex CLI is linked to; written by `bunx convex dev`.
# CONVEX_DEPLOYMENT=dev:your-deployment

# Convex deployment URL (…convex.cloud) — used by the Convex React client.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Convex site URL (…convex.site) — used as the Better Auth client baseURL.
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site
