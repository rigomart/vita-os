{
  "name": "vita-os",
  "type": "module",
  "catalog": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "lucide-react": "1.26.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4.3.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "turbo": "^2.9.12"
  },
  "overrides": {
    "date-fns": "4.2.1"
  },
  "packageManager": "bun@1.3.14",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint --fix --deny-warnings . && oxfmt --write .",
    "lint:check": "oxlint --deny-warnings . && oxfmt --check .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "convex": "turbo run convex --filter=@vita-os/web"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
