{
  "name": "vita-os",
  "type": "module",
  "devDependencies": {
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "turbo": "^2.8.10"
  },
  "packageManager": "bun@1.3.6",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint --fix --deny-warnings . && oxfmt --write .",
    "lint:check": "oxlint --deny-warnings . && oxfmt --check .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "convex": "turbo run convex --filter=@vita-os/web"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
