{
  "name": "@vita-os/local",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --fix --deny-warnings . && oxfmt --write .",
    "lint:check": "oxlint --deny-warnings . && oxfmt --check .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@vita-os/contracts": "workspace:*",
    "@vita-os/operations": "workspace:*",
    "drizzle-orm": "0.45.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "catalog:",
    "valibot": "1.5.0",
    "vitest": "4.1.7"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
