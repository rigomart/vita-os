# Capture a standalone Note, edit it in place in the live-preview editor, then delete with Undo and with the offer lapsing.
# Needs a fresh signed-in instance (up + signin). Reloads prove saved writes; D1 checks the stored Markdown source and the final deletion.
open /
browser -- find role button click --name "New note" --exact
see textbox "Note body" --in '[role=dialog]'
browser -- find label "Note body" fill "**Verify Note ${STAMP}**"
# Formatting renders while typing: the bold text is drawn bold in the editor itself.
browser -- wait --fn "[...document.querySelectorAll('[role=dialog] .cm-atomic-strong')].some(el => el.textContent.includes('Verify Note ${STAMP}'))"
shot notes-compose-before
browser -- click 'xpath=//*[@role="dialog"]//button[normalize-space()="Add"]'
see text "Note added"
# The Markdown source is stored as typed, which the rendered card cannot show.
d1 "SELECT COUNT(*) AS matching FROM notes WHERE body = '**Verify Note ${STAMP}**' AND state = 'open'"
expect '"matching": 1'
browser -- reload
see text "Verify Note ${STAMP}"
shot notes-captured-after

# A saved Note opens rendered, with no Read/Write switch. Editing marks it unsaved; Escape from discard keeps it.
browser -- find role button click --name "Open note: Verify Note ${STAMP}" --exact
see textbox "Note body" --in '[role=dialog]'
gone tab --in '[role=dialog]'
browser -- wait --fn "document.activeElement?.getAttribute('aria-label') !== 'Note body'"
shot notes-saved-open
# `fill` inserts at the caret in this editor instead of replacing, so select all and type.
browser -- click '[role=dialog] [aria-label="Note body"]'
browser -- press Meta+a
browser -- keyboard type "**Verify Edited ${STAMP}**"
see text "Unsaved changes"
browser -- press Escape
see text "Discard unsaved changes?"
shot notes-discard-before
browser -- press Escape
gone alertdialog
see text "Verify Edited ${STAMP}" --in '[role=dialog]'
shot notes-unsaved
browser -- find role button click --name Save --exact
see text "Note saved"
browser -- press Escape
browser -- reload
see text "Verify Edited ${STAMP}"
shot notes-edited-after

# Delete closes the view and hides the card. Undo restores it without deleting persisted data.
browser -- find role button click --name "Open note: Verify Edited ${STAMP}" --exact
browser -- find role button click --name "More actions" --exact
shot notes-delete-before
browser -- find role menuitem click --name "Delete note" --exact
see text "Note deleted"
gone button "Open note: Verify Edited ${STAMP}"
browser -- click 'xpath=//li[contains(@class,"cn-toast")][contains(.,"Note deleted")]//button[normalize-space()="Undo"]'
see text "Verify Edited ${STAMP}"
# Wait beyond the five-second offer, then reload to prove Undo lasted.
browser -- wait 7000
browser -- reload
see text "Verify Edited ${STAMP}"
shot notes-delete-undone-after

# A second deletion is allowed to commit after the Undo window.
browser -- find role button click --name "Open note: Verify Edited ${STAMP}" --exact
browser -- find role button click --name "More actions" --exact
browser -- find role menuitem click --name "Delete note" --exact
see text "Note deleted"
browser -- wait 8000
# The row is really deleted, not hidden.
d1 "SELECT COUNT(*) AS matching FROM notes WHERE body LIKE '%${STAMP}%'"
expect '"matching": 0'
browser -- reload
see text "Nothing is asking for you."
gone button "Verify Edited ${STAMP}" --contains
shot notes-deleted-after
