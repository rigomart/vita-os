# Resolve a Thread that has open Tasks, check its resolution entry names them, find it in History, reopen it.
# The Activity Log shows the resolution with the Tasks it dropped; D1 proves the stored content.
# Needs a signed-in instance (up + signin). Add Tasks with Enter in "Add a task"; never press Enter to commit an edit of an existing Task (use Tab).
open /
browser -- find role button click --name "New thread" --exact
browser -- find label "Thread title" fill "Resolve me ${STAMP}"
browser -- find role button click --name Create --exact
see text "Thread created"
see textbox "Add a task"
browser -- find label "Add a task" fill "Discard A ${STAMP}"
browser -- press Enter
see text "Discard A ${STAMP}"
browser -- find label "Add a task" fill "Discard B ${STAMP}"
browser -- press Enter
see text "Discard B ${STAMP}"
browser -- click 'xpath=//ul[@aria-label="Tasks"]/li[.//button[normalize-space()="Discard B ${STAMP}"]]//button[@aria-label="Focus this task"]'
see button "Unfocus this task" --in '[data-slot=thread-detail-pane]'
# Let the Task saves land before resolving.
browser -- wait 1500
shot resolve-before

browser -- find role button click --name "Thread actions" --exact
browser -- find role menuitem click --name Resolve --exact
browser -- find role button click --name "Resolve thread" --exact
see text "Thread resolved"
d1 "SELECT content, previous_value, new_value FROM activity_log_entries WHERE content LIKE 'Resolved thread%' AND content LIKE '%${STAMP}%'"
expect 'discarded tasks: \"Discard A ${STAMP}\", \"Discard B ${STAMP}\"'

# After a reload (the server's state), find it in History and open it: no Tasks while resolved, the log is the record.
browser -- reload
see banner "Vita OS"
browser -- press Meta+k
browser -- find role button click --name History --exact
see text "Resolve me ${STAMP}"
browser -- find role option click --name "Resolve me ${STAMP}"
see text "while resolved"
browser -- find role tab click --name "Activity" --exact
see text "Resolved the Thread"
see text "Dropped 2 open Tasks"
see text "Discard A ${STAMP}"
see text "Discard B ${STAMP}"
shot resolve-history

# Reopen from Thread actions: open again, Tasks and focus stay discarded.
browser -- find role button click --name "Thread actions" --exact
browser -- find role menuitem click --name Reopen --exact
see text "Thread reopened"
see textbox "Add a task"
shot resolve-reopened
browser -- reload
see textbox "Add a task"
gone button "Discard A ${STAMP}" --in '[data-slot=thread-detail-pane]'
gone button "Discard B ${STAMP}" --in '[data-slot=thread-detail-pane]'
gone button "Unfocus this task" --in '[data-slot=thread-detail-pane]'
