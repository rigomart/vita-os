# Complete a Task with a note (ADR 0032, issue #405): in Thread detail, "Complete with a note" opens a note line under the row;
# Enter completes the Task and captures the text as one Thread Note, in one command. A plain Task is removed (side pane, 1440x900),
# a repeating Task moves to its next occurrence (drawer, 1024x768, where Escape closes the note line and not the drawer), and a
# Dashboard card still completes in one click with no note. Each mutation is proven by a reload and D1: one Thread Note, one
# move_completed. Needs a signed-in instance (up + signin). Add Tasks with Enter in "Add a task"; never press Enter to commit an
# edit of an existing Task (use Tab). Enter in the note line is its own capture path. Restores 1440x900 at the end.
open /

# P: a plain Task, completed with a note in the side pane.
browser -- find role button click --name "New thread" --exact
browser -- find label "Thread title" fill "Note P ${STAMP}"
browser -- find role button click --name Create --exact
browser -- wait --text "Thread created"
settled '[data-slot=thread-detail-pane]'
browser -- find label "Add a task" fill "P1 ${STAMP}"
browser -- press Enter
browser -- wait --text "P1 ${STAMP}"
browser -- click 'xpath=//ul[@aria-label="Tasks"]/li[.//button[normalize-space()="P1 ${STAMP}"]]//button[@aria-label="Complete with a note"]'
see group "Complete “P1 ${STAMP}” with a note"
gone dialog
browser -- wait --fn "document.activeElement === document.querySelector('[data-slot=completion-note] textarea')"
browser -- fill '[data-slot=completion-note] textarea' "Picked up at the counter ${STAMP}"
shot note-line-pane
browser -- press Enter
gone group "with a note" --contains
gone list "Tasks" --in '[data-slot=thread-detail-pane]'
browser -- wait --text "Picked up at the counter ${STAMP}"
shot note-completed-pane
browser -- wait 1500
browser -- reload
see textbox "Add a task"
see text "Picked up at the counter ${STAMP}"
gone list "Tasks" --in '[data-slot=thread-detail-pane]'
d1 "SELECT COUNT(*) AS n FROM thread_notes n JOIN threads t ON t.id = n.thread_id WHERE t.title = 'Note P ${STAMP}'"
expect '"n": 1'
d1 "SELECT l.type, l.content, COUNT(*) AS n FROM activity_log_entries l JOIN threads t ON t.id = l.thread_id WHERE t.title = 'Note P ${STAMP}' GROUP BY l.type"
expect '"type": "move_completed"'
expect '"n": 1'
d1 "SELECT last_activity_content IS NULL AS note_is_last FROM threads WHERE title = 'Note P ${STAMP}'"
expect '"note_is_last": 1'

# R: a repeating Task (today, daily), completed with a note in the drawer. Escape closes the note line, not the drawer.
browser -- find role button click --name "Close thread" --exact
gone complementary "Note P ${STAMP}"
browser -- set viewport 1024 768
browser -- find role button click --name "New thread" --exact
browser -- find label "Thread title" fill "Note R ${STAMP}"
browser -- find role button click --name Create --exact
browser -- wait --text "Thread created"
see textbox "Add a task" --in '[role=dialog]'
settled '[data-vaul-drawer]'
browser -- find label "Add a task" fill "R1 ${STAMP}"
browser -- press Enter
browser -- wait --text "R1 ${STAMP}"
# At 1024 wide the "Thread created" toast covers the bottom of the picker until it leaves.
browser -- wait --fn "!document.querySelector('li.cn-toast')"
browser -- click 'xpath=//ul[@aria-label="Tasks"]/li[.//button[normalize-space()="R1 ${STAMP}"]]//button[@aria-label="Set date"]'
see button "Pick a date…"
browser -- click 'xpath=//*[@data-slot="popover-content"]//button[starts-with(@aria-label, "Today, ")]'
browser -- wait --fn "!document.querySelector('button[aria-label=\"Repeat, Never\"]').disabled"
browser -- find role button click --name "Repeat, Never" --exact
browser -- find role button click --name "Every day" --exact
see button "Repeat, Daily"
# Escape closes the picker alone; the drawer stays.
browser -- press Escape
gone button "Pick a date…"
browser -- wait 800
see dialog "Note R ${STAMP}"
see image "Repeats daily" --in '[role=dialog]'
browser -- wait 1500
browser -- click 'xpath=//ul[@aria-label="Tasks"]/li[.//button[normalize-space()="R1 ${STAMP}"]]//button[@aria-label="Complete with a note"]'
see group "Complete “R1 ${STAMP}” with a note"
browser -- fill '[data-slot=completion-note] textarea' "Draft to drop ${STAMP}"
browser -- press Escape
gone group "with a note" --contains
# Longer than the drawer's exit animation: it is still open.
browser -- wait 800
see dialog "Note R ${STAMP}"
see list "Tasks" --in '[role=dialog]'
browser -- click 'xpath=//ul[@aria-label="Tasks"]/li[.//button[normalize-space()="R1 ${STAMP}"]]//button[@aria-label="Complete with a note"]'
browser -- wait --fn "document.querySelector('[data-slot=completion-note] textarea')?.value === ''"
browser -- fill '[data-slot=completion-note] textarea' "Slept well ${STAMP}"
shot note-line-drawer
browser -- press Enter
gone group "with a note" --contains
see button "Change date: Tomorrow" --in '[role=dialog]'
browser -- wait --text "Slept well ${STAMP}"
shot note-completed-drawer
browser -- wait 1500
browser -- reload
see dialog "Note R ${STAMP}"
see text "Slept well ${STAMP}"
see button "Change date: Tomorrow" --in '[role=dialog]'
see image "Repeats daily" --in '[role=dialog]'
d1 "SELECT COUNT(*) AS n FROM thread_notes n JOIN threads t ON t.id = n.thread_id WHERE t.title = 'Note R ${STAMP}'"
expect '"n": 1'
d1 "SELECT l.type, COUNT(*) AS n FROM activity_log_entries l JOIN threads t ON t.id = l.thread_id WHERE t.title = 'Note R ${STAMP}' GROUP BY l.type"
expect '"type": "move_completed"'
expect '"n": 1'
browser -- find role button click --name "Close thread" --exact
gone dialog
browser -- set viewport 1440 900

# C: a Dashboard card completes in one click and never asks for a note.
browser -- find role button click --name "New thread" --exact
browser -- find label "Thread title" fill "Note C ${STAMP}"
browser -- find role button click --name Create --exact
browser -- wait --text "Thread created"
see textbox "Add a task"
browser -- find label "Add a task" fill "C1 ${STAMP}"
browser -- press Enter
browser -- wait --text "C1 ${STAMP}"
browser -- wait 1500
browser -- find role button click --name "Close thread" --exact
see button "Complete “C1 ${STAMP}”"
gone button "Complete with a note"
browser -- click 'xpath=//li[.//a[normalize-space()="Note C ${STAMP}"]]//button[starts-with(@aria-label, "Complete")]'
gone text "C1 ${STAMP}"
gone group "with a note" --contains
shot card-completed
browser -- wait 1500
d1 "SELECT l.type, COUNT(*) AS n FROM activity_log_entries l JOIN threads t ON t.id = l.thread_id WHERE t.title = 'Note C ${STAMP}' GROUP BY l.type"
expect '"type": "move_completed"'
expect '"n": 1'
d1 "SELECT COUNT(*) AS n FROM thread_notes n JOIN threads t ON t.id = n.thread_id WHERE t.title = 'Note C ${STAMP}'"
expect '"n": 0'
