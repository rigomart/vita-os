# Dashboard Notes filtering, Archive from the card and Note view, History search, and Unarchive.
# Needs a fresh signed-in instance (up + signin). Reloads prove saved writes; D1 tells archived from deleted.
open /
browser -- find role button click --name "New note" --exact
see textbox "Note body" --in '[role=dialog]'
browser -- find label "Note body" fill "Board note ${STAMP} needlealpha"
browser -- click 'xpath=//*[@role="dialog"]//button[normalize-space()="Add"]'
see text "Note added"
browser -- find role button click --name "New note" --exact
see textbox "Note body" --in '[role=dialog]'
browser -- find label "Note body" fill "History note ${STAMP} needlebeta"
browser -- click 'xpath=//*[@role="dialog"]//button[normalize-space()="Add"]'
see text "Note added"
browser -- reload
see text "Board note ${STAMP} needlealpha"
see text "History note ${STAMP} needlebeta"
browser -- find role link click --name "Notes 2" --exact
browser -- wait --fn "location.pathname === '/' && location.search === '?show=notes'"
shot notes-dashboard-before

# Archive the named card, then confirm only the other Note remains after a reload.
browser -- hover 'xpath=//li[.//button[@aria-label="Open note: Board note ${STAMP} needlealpha"]]'
browser -- click 'xpath=//li[.//button[@aria-label="Open note: Board note ${STAMP} needlealpha"]]//button[@aria-label="Archive note"]'
see text "Note archived"
browser -- reload
see text "History note ${STAMP} needlebeta"
gone button "Open note: Board note ${STAMP} needlealpha"
browser -- find role link click --name "Notes 1" --exact
shot notes-board-archived-after

# Archive from the view: it remains open over the empty Notes board and offers Unarchive.
browser -- find role button click --name "Open note: History note ${STAMP} needlebeta" --exact
browser -- wait --fn "location.search === '?show=notes'"
shot notes-view-archive-before
browser -- find role button click --name Archive --exact
see text "Note archived"
# Archived, not deleted: the board can't tell the two apart.
d1 "SELECT COUNT(*) AS matching FROM notes WHERE body = 'History note ${STAMP} needlebeta' AND state = 'done' AND completed_at IS NOT NULL"
expect '"matching": 1'
see button "Unarchive" --in '[role=dialog]'
shot notes-view-archived-after
browser -- press Escape
browser -- reload
see text "No Note is asking for you."

# Search Archived notes by body, showing the matching Note and excluding the other one.
browser -- press Meta+k
browser -- find role button click --name History --exact
browser -- find role combobox fill "needlealpha"
see text "Board note ${STAMP} needlealpha"
see option "needlealpha" --contains
gone option "needlebeta" --contains
shot notes-history-search-after
browser -- find role option click --name "Board note ${STAMP} needlealpha"
see button "Unarchive" --in '[role=dialog]'
shot notes-history-open-before
browser -- find role button click --name Unarchive --exact
see text "Note unarchived"
browser -- press Escape
browser -- reload
see text "Board note ${STAMP} needlealpha"
browser -- wait --fn "location.search === '?show=notes'"
gone button "Open note: History note ${STAMP} needlebeta"
shot notes-unarchived-after
