# Repeating Standalone Notes (ADR 0041, issue #458): a saved dated Note takes a monthly Repeat from its card's picker
# (compose has no Repeat row), wears the repeat glyph on its date and offers Complete in place of Archive; Complete moves it
# to the same day next month and writes no Activity Log entry; a missed one shows once under Late and Complete moves it to
# its next date; the Note view offers Complete beside Archive, Archive takes it off the board into History and Unarchive
# brings it back with its date and Repeat; clearing the date clears the Repeat and brings Archive back; adding a repeating
# Note to a Thread gives a dated Task carrying the Repeat; the card again at 1024x768. A one-off Note keeps Archive.
# Needs a signed-in instance (up + signin). Dates are relative to today: quick picks by their prefix ("Today, ",
# "Tomorrow, "), past days by td[data-day] behind "Pick a date…", the monthly preset by its prefix "Every month on the".
# Completing a Note has no toast; each write is proven by a reload. Restores 1440x900 at the end.
open /
browser -- set viewport 1440 900

# A: a Note dated today. Compose offers the date but no Repeat.
browser -- find role button click --name "New note" --exact
see textbox "Note body" --in '[role=dialog]'
browser -- find label "Note body" fill "Pay N ${STAMP}"
browser -- find role button click --name "Follow-up date" --exact
see button "Pick a date…"
gone button "Repeat" --contains --in '[data-slot=popover-content]'
shot repeat-note-compose
browser -- click 'xpath=//*[@data-slot="popover-content"]//button[starts-with(@aria-label, "Today, ")]'
browser -- wait --fn "!document.querySelector('[data-slot=popover-content]')"
browser -- click 'xpath=//*[@role="dialog"]//button[normalize-space()="Add"]'
see text "Note added"
browser -- reload
see button "Open note: Pay N ${STAMP}" --in "section[aria-label='Today']"
# One-off: Archive, no Complete.
see button "Archive note" --in "section[aria-label='Today']"
gone button "Complete · back" --contains --in "section[aria-label='Today']"

# The card's picker: Repeat, Never, then the monthly preset on today's day.
browser -- hover 'xpath=//li[.//button[@aria-label="Open note: Pay N ${STAMP}"]]'
browser -- click 'xpath=//li[.//button[@aria-label="Open note: Pay N ${STAMP}"]]//button[@aria-label="Change follow-up date"]'
browser -- find role button click --name "Repeat, Never" --exact
see button "Every month on the" --contains
shot repeat-note-presets
browser -- click 'xpath=//*[@data-slot="popover-content"]//button[starts-with(@aria-label, "Every month on the")]'
browser -- wait --fn "!document.querySelector('[data-slot=popover-content]')"
browser -- wait 1500
browser -- reload
see button "Open note: Pay N ${STAMP}" --in "section[aria-label='Today']"
see image "Repeats monthly on the" --contains --in "section[aria-label='Today']"
see button "Complete · back" --contains --in "section[aria-label='Today']"
gone button "Archive note" --in "section[aria-label='Today']"
browser -- hover 'xpath=//li[.//button[@aria-label="Open note: Pay N ${STAMP}"]]'
shot repeat-note-card
d1 "SELECT repeat FROM notes WHERE body = 'Pay N ${STAMP}'"
expect '{\"kind\":\"monthly\",\"day\":'

# Complete from the card: it leaves Today for the same day next month; no Activity Log entry names it.
browser -- click 'xpath=//li[.//button[@aria-label="Open note: Pay N ${STAMP}"]]//button[starts-with(@aria-label, "Complete · back")]'
gone button "Open note: Pay N ${STAMP}" --in "section[aria-label='Today']"
browser -- wait 1500
browser -- reload
see button "Open note: Pay N ${STAMP}"
gone button "Open note: Pay N ${STAMP}" --in "section[aria-label='Today']"
browser -- wait --fn "(() => { const t = new Date(); const n = new Date(t.getFullYear(), t.getMonth() + 1, 1); n.setDate(Math.min(t.getDate(), new Date(n.getFullYear(), n.getMonth() + 1, 0).getDate())); const label = n.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }); return [...document.querySelectorAll('li')].some(li => li.querySelector('button[aria-label=\"Open note: Pay N ${STAMP}\"]') && li.textContent.includes(label)); })()"
shot repeat-note-completed
d1 "SELECT COUNT(*) AS n FROM activity_log_entries WHERE content LIKE '%Pay N ${STAMP}%'"
expect '"n": 0'

# L: a Note dated six days ago with the monthly Repeat shows once, under Late; Complete moves it to its next date.
browser -- find role button click --name "New note" --exact
see textbox "Note body" --in '[role=dialog]'
browser -- find label "Note body" fill "Late N ${STAMP}"
browser -- find role button click --name "Follow-up date" --exact
browser -- find role button click --name "Pick a date…" --exact
browser -- wait '[data-slot=popover-content] td[data-day]'
browser -- eval "(() => { const k = (() => { const d = new Date(); d.setDate(d.getDate() - 6); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); })(); if (!document.querySelector(\"td[data-day='\" + k + \"']\")) document.querySelector(\"button[aria-label*='Previous Month']\").click(); })()"
browser -- wait --fn "!!document.querySelector(\"td[data-day='\" + (() => { const d = new Date(); d.setDate(d.getDate() - 6); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); })() + \"']\")"
browser -- eval "document.querySelector(\"td[data-day='\" + (() => { const d = new Date(); d.setDate(d.getDate() - 6); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); })() + \"'] button\").click()"
browser -- wait --fn "!document.querySelector('[data-slot=popover-content]')"
browser -- click 'xpath=//*[@role="dialog"]//button[normalize-space()="Add"]'
see text "Note added"
browser -- reload
see button "Open note: Late N ${STAMP}" --in "section[aria-label='Late']"
browser -- hover 'xpath=//li[.//button[@aria-label="Open note: Late N ${STAMP}"]]'
browser -- click 'xpath=//li[.//button[@aria-label="Open note: Late N ${STAMP}"]]//button[@aria-label="Change follow-up date"]'
browser -- find role button click --name "Repeat, Never" --exact
browser -- click 'xpath=//*[@data-slot="popover-content"]//button[starts-with(@aria-label, "Every month on the")]'
browser -- wait --fn "!document.querySelector('[data-slot=popover-content]')"
browser -- wait 1500
browser -- reload
see image "Repeats monthly on the" --contains --in "section[aria-label='Late']"
browser -- wait --fn "document.querySelectorAll('button[aria-label=\"Open note: Late N ${STAMP}\"]').length === 1 && !!document.querySelector(\"section[aria-label='Late'] button[aria-label='Open note: Late N ${STAMP}']\")"
browser -- hover 'xpath=//li[.//button[@aria-label="Open note: Late N ${STAMP}"]]'
shot repeat-note-late
browser -- click 'xpath=//li[.//button[@aria-label="Open note: Late N ${STAMP}"]]//button[starts-with(@aria-label, "Complete · back")]'
gone button "Open note: Late N ${STAMP}" --in "section[aria-label='Late']"
browser -- wait 1500
browser -- reload
see button "Open note: Late N ${STAMP}"
gone button "Open note: Late N ${STAMP}" --in "section[aria-label='Late']"

# The Note view: its date wears the glyph and Complete sits beside Archive; the next date is a month after the late one.
browser -- find role button click --name "Open note: Late N ${STAMP}" --exact
see text "Late N ${STAMP}" --in '[role=dialog]'
see image "Repeats monthly on the" --contains --in '[role=dialog]'
browser -- wait --fn "(() => { const l = new Date(); l.setDate(l.getDate() - 6); const at = (n) => { const t = new Date(l.getFullYear(), l.getMonth() + n, 1); t.setDate(Math.min(l.getDate(), new Date(t.getFullYear(), t.getMonth() + 1, 0).getDate())); return t.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }); }; return document.querySelector('[role=dialog]').textContent.includes(at(1)) && !!document.querySelector('[role=dialog] button[aria-label=\"Complete · back ' + at(2) + '\"]'); })()"
see button "Archive" --in '[role=dialog]'
shot repeat-note-view

# Archive ends the rhythm on the board; History finds it; Unarchive brings it back with its date and Repeat.
browser -- find role button click --name Archive --exact
see text "Note archived"
see button "Unarchive" --in '[role=dialog]'
gone button "Complete · back" --contains --in '[role=dialog]'
browser -- press Escape
gone dialog
browser -- reload
see button "Open note: Pay N ${STAMP}"
gone button "Open note: Late N ${STAMP}"
browser -- press Meta+k
browser -- find role button click --name History --exact
browser -- find role combobox fill "Late N ${STAMP}"
see option "Late N ${STAMP}" --contains
shot repeat-note-history
browser -- click 'xpath=//*[@role="option"][contains(., "Late N ${STAMP}")]'
see button "Unarchive" --in '[role=dialog]'
browser -- find role button click --name Unarchive --exact
see text "Note unarchived"
browser -- press Escape
gone dialog
browser -- reload
see button "Open note: Late N ${STAMP}"
browser -- find role button click --name "Open note: Late N ${STAMP}" --exact
see text "Late N ${STAMP}" --in '[role=dialog]'
see image "Repeats monthly on the" --contains --in '[role=dialog]'
see button "Complete · back" --contains --in '[role=dialog]'

# Clearing the date clears the Repeat: the card is back under No date with Archive.
browser -- find role button click --name "Change follow-up date" --exact
browser -- find role button click --name "Clear follow-up date" --exact
gone image "Repeats monthly on the" --contains --in '[role=dialog]'
gone button "Complete · back" --contains --in '[role=dialog]'
browser -- press Escape
gone dialog
browser -- wait 1500
browser -- reload
see button "Open note: Late N ${STAMP}" --in "aside[aria-label='No date']"
browser -- hover 'xpath=//li[.//button[@aria-label="Open note: Late N ${STAMP}"]]'
see button "Archive note" --in "aside[aria-label='No date']"
gone image "Repeats monthly on the" --contains --in "aside[aria-label='No date']"
shot repeat-note-cleared
d1 "SELECT COUNT(*) AS n FROM notes WHERE body = 'Late N ${STAMP}' AND repeat IS NULL AND attention_date IS NULL"
expect '"n": 1'

# T: a repeating Note added to a Thread becomes a dated Task carrying the Repeat.
browser -- find role button click --name "New thread" --exact
browser -- find label "Thread title" fill "Repeat target ${STAMP}"
browser -- find role button click --name Create --exact
see text "Thread created"
see complementary "Repeat target ${STAMP}"
settled '[data-slot=thread-detail-pane]'
browser -- find role button click --name "Close thread" --exact
gone complementary "Repeat target ${STAMP}"
browser -- find role button click --name "New note" --exact
see textbox "Note body" --in '[role=dialog]'
browser -- find label "Note body" fill "Move N ${STAMP}"
browser -- find role button click --name "Follow-up date" --exact
browser -- click 'xpath=//*[@data-slot="popover-content"]//button[starts-with(@aria-label, "Tomorrow, ")]'
browser -- wait --fn "!document.querySelector('[data-slot=popover-content]')"
browser -- click 'xpath=//*[@role="dialog"]//button[normalize-space()="Add"]'
see text "Note added"
browser -- reload
see button "Open note: Move N ${STAMP}"
browser -- find role button click --name "Open note: Move N ${STAMP}" --exact
see text "Move N ${STAMP}" --in '[role=dialog]'
browser -- find role button click --name "Change follow-up date" --exact
browser -- find role button click --name "Repeat, Never" --exact
browser -- click 'xpath=//*[@data-slot="popover-content"]//button[starts-with(@aria-label, "Every month on the")]'
see button "Complete · back" --contains --in '[role=dialog]'
browser -- wait 1500
browser -- find role button click --name "More actions" --exact
browser -- find role menuitem click --name "Add to thread…" --exact
see option "Repeat target ${STAMP}" --contains
browser -- find role option click --name "Repeat target ${STAMP}" --contains
see text "Note added to thread"
browser -- wait 7000
browser -- reload
see link "Repeat target ${STAMP}"
gone button "Open note: Move N ${STAMP}"
browser -- find role link click --name "Repeat target ${STAMP}" --exact
see complementary "Repeat target ${STAMP}"
see button "Move N ${STAMP}" --in '[data-slot=thread-detail-pane]'
see button "Change date: Tomorrow" --in '[data-slot=thread-detail-pane]'
see image "Repeats monthly on the" --contains --in '[data-slot=thread-detail-pane]'
shot repeat-note-added-task
settled '[data-slot=thread-detail-pane]'
browser -- find role button click --name "Close thread" --exact
gone complementary "Repeat target ${STAMP}"

# 1024x768: the card's picker sets the Repeat and its Complete moves the Note on.
browser -- set viewport 1024 768
open /
browser -- find role button click --name "New note" --exact
see textbox "Note body" --in '[role=dialog]'
browser -- find label "Note body" fill "Narrow N ${STAMP}"
browser -- find role button click --name "Follow-up date" --exact
browser -- click 'xpath=//*[@data-slot="popover-content"]//button[starts-with(@aria-label, "Today, ")]'
browser -- wait --fn "!document.querySelector('[data-slot=popover-content]')"
browser -- click 'xpath=//*[@role="dialog"]//button[normalize-space()="Add"]'
see text "Note added"
browser -- reload
see button "Open note: Narrow N ${STAMP}" --in "section[aria-label='Today']"
browser -- hover 'xpath=//li[.//button[@aria-label="Open note: Narrow N ${STAMP}"]]'
browser -- click 'xpath=//li[.//button[@aria-label="Open note: Narrow N ${STAMP}"]]//button[@aria-label="Change follow-up date"]'
browser -- find role button click --name "Repeat, Never" --exact
browser -- click 'xpath=//*[@data-slot="popover-content"]//button[starts-with(@aria-label, "Every month on the")]'
browser -- wait --fn "!document.querySelector('[data-slot=popover-content]')"
browser -- wait 1500
browser -- reload
see image "Repeats monthly on the" --contains --in "section[aria-label='Today']"
browser -- hover 'xpath=//li[.//button[@aria-label="Open note: Narrow N ${STAMP}"]]'
shot repeat-note-card-1024
browser -- click 'xpath=//li[.//button[@aria-label="Open note: Narrow N ${STAMP}"]]//button[starts-with(@aria-label, "Complete · back")]'
gone button "Open note: Narrow N ${STAMP}" --in "section[aria-label='Today']"
browser -- wait 1500
browser -- reload
see button "Open note: Narrow N ${STAMP}"
gone button "Open note: Narrow N ${STAMP}" --in "section[aria-label='Today']"
browser -- set viewport 1440 900
