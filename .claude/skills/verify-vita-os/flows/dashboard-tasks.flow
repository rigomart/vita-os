# Dashboard card task slot: one Task, several unfocused ("N tasks · none focused"), one focused; complete from the card.
# Needs a signed-in instance (up + signin). Add Tasks with Enter in "Add a task"; never press Enter to commit an edit of an existing Task (use Tab).
open /

# Thread One: a single Task, shown without asking for a focus.
browser -- find role button click --name "New thread" --exact
browser -- find label "Thread title" fill "Card one ${STAMP}"
browser -- find role button click --name Create --exact
see text "Thread created"
see textbox "Add a task"
browser -- find label "Add a task" fill "Only task ${STAMP}"
browser -- press Enter
see text "Only task ${STAMP}"

# Thread Many: three Tasks, none focused.
# An open Thread pane covers the header's actions and the right of the list (ADR 0023, ADR 0037), so close it first.
browser -- find role button click --name "Close thread" --exact
gone complementary "Card one ${STAMP}"
browser -- find role button click --name "New thread" --exact
browser -- find label "Thread title" fill "Card many ${STAMP}"
browser -- find role button click --name Create --exact
see text "Thread created"
see textbox "Add a task"
browser -- find label "Add a task" fill "Many 1 ${STAMP}"
browser -- press Enter
see text "Many 1 ${STAMP}"
browser -- find label "Add a task" fill "Many 2 ${STAMP}"
browser -- press Enter
see text "Many 2 ${STAMP}"
browser -- find label "Add a task" fill "Many 3 ${STAMP}"
browser -- press Enter
see text "Many 3 ${STAMP}"

# Thread Focus: two Tasks, the second focused.
# An open Thread pane covers the header's actions and the right of the list (ADR 0023, ADR 0037), so close it first.
browser -- find role button click --name "Close thread" --exact
gone complementary "Card many ${STAMP}"
browser -- find role button click --name "New thread" --exact
browser -- find label "Thread title" fill "Card focus ${STAMP}"
browser -- find role button click --name Create --exact
see text "Thread created"
see textbox "Add a task"
browser -- find label "Add a task" fill "Focus 1 ${STAMP}"
browser -- press Enter
see text "Focus 1 ${STAMP}"
browser -- find label "Add a task" fill "Focus 2 ${STAMP}"
browser -- press Enter
see text "Focus 2 ${STAMP}"
browser -- click 'xpath=//ul[@aria-label="Tasks"]/li[.//button[normalize-space()="Focus 2 ${STAMP}"]]//button[@aria-label="Focus this task"]'
see button "Unfocus this task" --in '[data-slot=thread-detail-pane]'

browser -- wait 1500
open /
see text "Ready to move"
see text "Card focus ${STAMP}"
see text "3 tasks · none focused"
shot dash-task-slots

# Complete from the card: the focused Task, then the only Task.
browser -- find role button click --name "Complete “Focus 2 ${STAMP}”" --exact
gone text "Focus 2 ${STAMP}"
browser -- find role button click --name "Complete “Only task ${STAMP}”" --exact
gone text "Only task ${STAMP}"
shot dash-task-completed

browser -- wait 1500
open /
see link "Card many ${STAMP}"
see text "3 tasks · none focused"
gone text "Focus 2 ${STAMP}"
gone text "Only task ${STAMP}"
shot dash-task-after-reload
