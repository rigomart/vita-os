# Dated Tasks (ADR 0032): set a date with a time from a Task row, placement and the card's lead, reschedule from the
# card token, two Tasks on one day, a card with no single Task, Thread detail order, and a dated Note added to a Thread.
# Needs a signed-in instance (up + signin). Add Tasks with Enter in "Add a task"; never press Enter to commit an edit of an existing Task (use Tab).
# Dates are picked relative to today by the calendar's data-day cells. When a day is not in the month the picker shows, the flow steps
# to the next month first, so it runs on any day of the month. The time field is typed key by key (find ... fill leaves Chrome's
# time input empty).
open /

# A: a Thread with one Task; give the Task a date two days out and 3:30 PM from its row.
browser -- find role button click --name "New thread" --exact
browser -- find label "Thread title" fill "Dated A ${STAMP}"
browser -- find role button click --name Create --exact
browser -- wait --text "Thread created"
browser -- wait 'input[aria-label="Add a task"]'
browser -- find label "Add a task" fill "A1 ${STAMP}"
browser -- press Enter
browser -- wait --text "A1 ${STAMP}"
shot dated-a-before
browser -- click 'xpath=//ul[@aria-label="Tasks"]/li[.//button[normalize-space()="A1 ${STAMP}"]]//button[@aria-label="Set date"]'
browser -- find role button click --name "Add time" --exact
browser -- press 3
browser -- press 3
browser -- press 0
browser -- press p
browser -- wait --fn "document.querySelector('input[type=time]').value === '15:30'"
browser -- eval "(() => { const k = (() => { const d = new Date(); d.setDate(d.getDate() + 2); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); })(); if (!document.querySelector(\"td[data-day='\" + k + \"']\")) document.querySelector(\"button[aria-label*='Next Month']\").click(); })()"
browser -- wait --fn "!!document.querySelector(\"td[data-day='\" + (() => { const d = new Date(); d.setDate(d.getDate() + 2); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); })() + \"']\")"
browser -- eval "document.querySelector(\"td[data-day='\" + (() => { const d = new Date(); d.setDate(d.getDate() + 2); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); })() + \"'] button\").click()"
# A row's picker stays open after a day is picked (its Repeat can follow); Escape closes it (a toast can cover Done).
browser -- press Escape
browser -- wait --fn "!document.querySelector('[data-slot=popover-content]')"

# The Thread leaves the No date tray for This week, under that day's heading, and its card leads with A1 and its time.
browser -- wait --fn "(() => { const d = new Date(); d.setDate(d.getDate() + 2); const day = d.toLocaleDateString('en-US', { weekday: 'long' }); return [...document.querySelectorAll(\"section[aria-label='This week'] section[aria-label='\" + day + \"'] li\")].some(li => li.textContent.includes('Dated A ${STAMP}') && li.textContent.includes('A1 ${STAMP}') && li.textContent.includes('3:30 PM')); })()"
browser -- wait --fn "![...document.querySelectorAll(\"aside[aria-label='No date'] li\")].some(li => li.textContent.includes('Dated A ${STAMP}'))"
shot dated-a-placed

# Reschedule from the card's own token: one day later, the time kept.
browser -- click 'xpath=//li[.//a[normalize-space()="Dated A ${STAMP}"]]//button[@aria-label="Change date"]'
browser -- eval "(() => { const k = (() => { const d = new Date(); d.setDate(d.getDate() + 3); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); })(); if (!document.querySelector(\"td[data-day='\" + k + \"']\")) document.querySelector(\"button[aria-label*='Next Month']\").click(); })()"
browser -- wait --fn "!!document.querySelector(\"td[data-day='\" + (() => { const d = new Date(); d.setDate(d.getDate() + 3); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); })() + \"']\")"
browser -- eval "document.querySelector(\"td[data-day='\" + (() => { const d = new Date(); d.setDate(d.getDate() + 3); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); })() + \"'] button\").click()"
browser -- wait --fn "(() => { const d = new Date(); d.setDate(d.getDate() + 3); const day = d.toLocaleDateString('en-US', { weekday: 'long' }); return [...document.querySelectorAll(\"section[aria-label='This week'] section[aria-label='\" + day + \"'] li\")].some(li => li.textContent.includes('Dated A ${STAMP}') && li.textContent.includes('3:30 PM')); })()"
shot dated-a-rescheduled

# Setting dates writes no Activity Log entry; the date sits inside the Task JSON with its time (15:30 is 30 past an hour).
browser -- wait 1500
d1 "SELECT json_extract(moves_json, '$[0].text') AS text, json_extract(moves_json, '$[0].date') / 60000 % 60 AS minute FROM threads WHERE title = 'Dated A ${STAMP}'"
expect '"minute": 30'
d1 "SELECT COUNT(*) AS n FROM activity_log_entries l JOIN threads t ON t.id = l.thread_id WHERE t.title = 'Dated A ${STAMP}'"
expect '"n": 0'

# C: two dated Tasks on the same day read as a count and never pick one.
browser -- find role button click --name "New thread" --exact
browser -- find label "Thread title" fill "Dated C ${STAMP}"
browser -- find role button click --name Create --exact
browser -- wait --text "Thread created"
browser -- wait 'input[aria-label="Add a task"]'
browser -- find label "Add a task" fill "C1 ${STAMP}"
browser -- press Enter
browser -- wait --text "C1 ${STAMP}"
browser -- find label "Add a task" fill "C2 ${STAMP}"
browser -- press Enter
browser -- wait --text "C2 ${STAMP}"
browser -- click 'xpath=//ul[@aria-label="Tasks"]/li[.//button[normalize-space()="C1 ${STAMP}"]]//button[@aria-label="Set date"]'
browser -- click 'xpath=//td[@data-today]//button'
browser -- press Escape
browser -- wait --fn "!document.querySelector('[data-slot=popover-content]')"
browser -- wait --fn "document.querySelectorAll('ul[aria-label=\"Tasks\"] > li button[aria-label^=\"Change date\"]').length === 1"
browser -- click 'xpath=//ul[@aria-label="Tasks"]/li[.//button[normalize-space()="C2 ${STAMP}"]]//button[@aria-label="Set date"]'
browser -- click 'xpath=//td[@data-today]//button'
browser -- press Escape
browser -- wait --fn "!document.querySelector('[data-slot=popover-content]')"
browser -- wait --fn "[...document.querySelectorAll(\"section[aria-label='Now'] li\")].some(li => li.textContent.includes('Dated C ${STAMP}') && li.textContent.includes('2 tasks today') && !li.textContent.includes('C1 ${STAMP}'))"
shot dated-c-two-today

# B: two undated Tasks, none focused: the card shows no single Task. Setting a date adds a Task named "Follow up".
browser -- find role button click --name "New thread" --exact
browser -- find label "Thread title" fill "Dated B ${STAMP}"
browser -- find role button click --name Create --exact
browser -- wait --text "Thread created"
browser -- wait 'input[aria-label="Add a task"]'
browser -- find label "Add a task" fill "B1 ${STAMP}"
browser -- press Enter
browser -- wait --text "B1 ${STAMP}"
browser -- find label "Add a task" fill "B2 ${STAMP}"
browser -- press Enter
browser -- wait --text "B2 ${STAMP}"
browser -- wait 1500
open /
browser -- wait --text "2 tasks · none focused"
shot dated-b-before
browser -- click 'xpath=//li[.//a[normalize-space()="Dated B ${STAMP}"]]//button[@aria-label="Set date"]'
browser -- eval "(() => { const k = (() => { const d = new Date(); d.setDate(d.getDate() + 4); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); })(); if (!document.querySelector(\"td[data-day='\" + k + \"']\")) document.querySelector(\"button[aria-label*='Next Month']\").click(); })()"
browser -- wait --fn "!!document.querySelector(\"td[data-day='\" + (() => { const d = new Date(); d.setDate(d.getDate() + 4); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); })() + \"']\")"
browser -- eval "document.querySelector(\"td[data-day='\" + (() => { const d = new Date(); d.setDate(d.getDate() + 4); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); })() + \"'] button\").click()"
browser -- wait --fn "[...document.querySelectorAll(\"section[aria-label='This week'] li\")].some(li => li.textContent.includes('Dated B ${STAMP}') && li.textContent.includes('Follow up'))"
shot dated-b-after

# Thread detail: the dated Task first, then the quiet No date divider, then the undated Tasks in capture order.
browser -- find role link click --name "Dated B ${STAMP}"
browser -- wait 'ul[aria-label="Tasks"]'
browser -- wait --fn "(() => { const t = document.querySelector(\"section[aria-label='Thread attention']\").innerText; const f = t.indexOf('Follow up'); const n = t.toLowerCase().indexOf('no date'); const b1 = t.indexOf('B1 ${STAMP}'); const b2 = t.indexOf('B2 ${STAMP}'); return f >= 0 && f < n && n < b1 && b1 < b2; })()"
shot dated-b-detail
browser -- wait 1500
d1 "SELECT json_extract(moves_json, '$[2].text') AS text, json_extract(moves_json, '$[2].date') IS NOT NULL AS dated FROM threads WHERE title = 'Dated B ${STAMP}'"
expect Follow up
expect '"dated": 1'

# D: a dated Standalone Note added to a Thread becomes a dated Task named by its first line (Markdown marker stripped).
browser -- find role button click --name "New thread" --exact
browser -- find label "Thread title" fill "Dated D ${STAMP}"
browser -- find role button click --name Create --exact
browser -- wait --text "Thread created"
browser -- find role button click --name "New note" --exact
browser -- find label "Note body" fill "## Note task ${STAMP}"
browser -- find role button click --name "Follow-up date" --exact
browser -- eval "(() => { const k = (() => { const d = new Date(); d.setDate(d.getDate() + 5); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); })(); if (!document.querySelector(\"td[data-day='\" + k + \"']\")) document.querySelector(\"button[aria-label*='Next Month']\").click(); })()"
browser -- wait --fn "!!document.querySelector(\"td[data-day='\" + (() => { const d = new Date(); d.setDate(d.getDate() + 5); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); })() + \"']\")"
browser -- eval "document.querySelector(\"td[data-day='\" + (() => { const d = new Date(); d.setDate(d.getDate() + 5); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); })() + \"'] button\").click()"
browser -- find role button click --name "Add" --exact
browser -- wait --text "Note added"
browser -- find role button click --name "Open note: Note task ${STAMP}"
browser -- find role button click --name "More actions" --exact
browser -- find role menuitem click --name "Add to thread…" --exact
browser -- find role option click --name "Dated D ${STAMP}"
browser -- wait --text "Note added to thread"
# Until the conversion settles (the Undo window plus the request), the whole Thread takes no Task command: its Task reads Adding… and is busy, and every control, Add a task included, is disabled.
browser -- find role link click --name "Dated D ${STAMP}"
browser -- wait --fn "[...document.querySelectorAll('ul[aria-label=\"Tasks\"] > li')].some(li => li.textContent.includes('Note task ${STAMP}') && li.getAttribute('aria-busy') === 'true' && li.textContent.includes('Adding…') && li.querySelector('button[aria-label=\"Complete task\"]').disabled && li.querySelector('button[aria-label=\"Remove task\"]').disabled) && document.querySelector('input[aria-label=\"Add a task\"]').disabled"
shot dated-d-pending
# Then it is usable.
browser -- wait --fn "[...document.querySelectorAll('ul[aria-label=\"Tasks\"] > li')].some(li => li.textContent.includes('Note task ${STAMP}') && !li.hasAttribute('aria-busy') && !li.querySelector('button[aria-label=\"Complete task\"]').disabled) && !document.querySelector('input[aria-label=\"Add a task\"]').disabled"
shot dated-d-usable
# The write lands after the five-second Undo window.
browser -- wait 2000
browser -- wait --fn "[...document.querySelectorAll(\"section[aria-label='This week'] li\")].some(li => li.textContent.includes('Dated D ${STAMP}') && li.textContent.includes('Note task ${STAMP}'))"
shot dated-d-added
d1 "SELECT json_extract(moves_json, '$[0].text') AS text, json_extract(moves_json, '$[0].date') IS NOT NULL AS dated, focused_move_id FROM threads WHERE title = 'Dated D ${STAMP}'"
expect Note task ${STAMP}
expect '"dated": 1'
d1 "SELECT COUNT(*) AS n FROM thread_notes n JOIN threads t ON t.id = n.thread_id WHERE t.title = 'Dated D ${STAMP}' AND n.body = '## Note task ${STAMP}'"
expect '"n": 1'
d1 "SELECT COUNT(*) AS n FROM activity_log_entries l JOIN threads t ON t.id = l.thread_id WHERE t.title LIKE 'Dated % ${STAMP}'"
expect '"n": 0'

# Completing the converted Task goes out once, against the revision the conversion left: it is gone and logged once.
browser -- click 'xpath=//ul[@aria-label="Tasks"]/li[.//button[normalize-space()="Note task ${STAMP}"]]//button[@aria-label="Complete task"]'
browser -- wait --fn "![...document.querySelectorAll('ul[aria-label=\"Tasks\"] > li')].some(li => li.textContent.includes('Note task ${STAMP}'))"
browser -- wait 1500
shot dated-d-completed
d1 "SELECT COALESCE(json_array_length(moves_json), 0) AS tasks FROM threads WHERE title = 'Dated D ${STAMP}'"
expect '"tasks": 0'
d1 "SELECT COUNT(*) AS n FROM activity_log_entries l JOIN threads t ON t.id = l.thread_id WHERE t.title = 'Dated D ${STAMP}'"
expect '"n": 1'
